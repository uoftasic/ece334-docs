    \bottomrule
  \end{tabularx}}
}

\newcommand{\labfigure}[3][0.85\linewidth]{%
  % #1 = width, #2 = image path, #3 = caption
  \begin{figure}[htbp]
    \centering
    \IfFileExists{#2}{%
      \includegraphics[width=#1]{#2}%
    }{%
      \fbox{\parbox[c][2.2in][c]{#1}{\centering\small\textit{Figure placeholder}\\[0.3em]#2}}%
    }%
    \caption{#3}
  \end{figure}
}

